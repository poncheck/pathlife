# PathLife Environment Configuration
# Copy this file to .env and fill in your values

# Security Settings
# ⚠️ CRITICAL: Change these in production!
# Generate secure keys with: openssl rand -base64 32
JWT_SECRET=change-me-use-long-random-string-min-32-chars
ENCRYPTION_KEY=change-me-use-32-character-string
ADMIN_PASSWORD=admin123

# Immich Configuration
IMMICH_URL=https://your-immich-instance.com
IMMICH_API_KEY=your-immich-api-key-here

# Strava Configuration
# Get these from: https://www.strava.com/settings/api
STRAVA_CLIENT_ID=your-client-id
STRAVA_CLIENT_SECRET=your-client-secret
STRAVA_REFRESH_TOKEN=your-refresh-token

# Traccar Configuration
TRACCAR_URL=https://your-traccar-instance.com
TRACCAR_EMAIL=your-email@example.com
TRACCAR_PASSWORD=your-password

# Sync Schedule (cron format)
# ⚠️ IMPORTANT: Strava API limits are 100 requests/15min and 1000 requests/day
# Recommended: sync every 6-12 hours to avoid rate limits
#
# Examples:
# Every 6 hours:  0 */6 * * *
# Every 12 hours: 0 */12 * * *
# Daily at 6am:   0 6 * * *
# Twice daily:    0 6,18 * * *
SYNC_SCHEDULE=0 */6 * * *
