generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model DiaryEntry {
  id          String   @id @default(uuid())
  date        DateTime @unique
  description String?
  gpxPath     String?  // Path to combined GPX file for the day (from Traccar)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  photos     Photo[]
  activities Activity[]
  locations  Location[]
}

model Photo {
  id           String     @id @default(uuid())
  immichId     String     @unique
  immichUrl    String
  thumbnailUrl String?
  takenAt      DateTime
  selected     Boolean    @default(false)
  metadata     String?    // JSON string for additional metadata

  diaryEntryId String
  diaryEntry   DiaryEntry @relation(fields: [diaryEntryId], references: [id], onDelete: Cascade)

  createdAt    DateTime   @default(now())

  @@index([diaryEntryId])
  @@index([takenAt])
}

model Activity {
  id             String     @id @default(uuid())
  stravaId       String     @unique
  name           String
  type           String
  distance       Float?
  movingTime     Int?
  elapsedTime    Int?
  totalElevation Float?
  startDate      DateTime
  endDate        DateTime?
  polyline       String?
  gpxPath        String?    // Path to local GPX file
  metadata       String?    // JSON string for additional metadata

  diaryEntryId   String
  diaryEntry     DiaryEntry @relation(fields: [diaryEntryId], references: [id], onDelete: Cascade)

  createdAt      DateTime   @default(now())

  @@index([diaryEntryId])
  @@index([startDate])
}

model Location {
  id           String     @id @default(uuid())
  traccarId    String?
  latitude     Float
  longitude    Float
  address      String?
  timestamp    DateTime
  speed        Float?
  altitude     Float?
  metadata     String?    // JSON string for additional metadata

  diaryEntryId String
  diaryEntry   DiaryEntry @relation(fields: [diaryEntryId], references: [id], onDelete: Cascade)

  createdAt    DateTime   @default(now())

  @@index([diaryEntryId])
  @@index([timestamp])
}

model SyncLog {
  id        String   @id @default(uuid())
  source    String   // 'immich', 'strava', 'traccar'
  status    String   // 'success', 'error'
  message   String?
  itemCount Int      @default(0)
  timestamp DateTime @default(now())

  @@index([source, timestamp])
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  password  String   // Bcrypt hashed password
  email     String?
  role      String   @default("admin") // 'admin', 'user'
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([username])
}

model Settings {
  id    String @id @default(uuid())
  key   String @unique // e.g., 'immich_url', 'strava_client_id'
  value String // Encrypted sensitive data
  type  String // 'immich', 'strava', 'traccar', 'system'

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
}

model NightStay {
  id               String   @id @default(uuid())
  date             String   @unique // YYYY-MM-DD
  latitude         Float
  longitude        Float
  address          String?
  distanceFromHome Float
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([date])
}
